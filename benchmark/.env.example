# Copy this file to benchmark/.env (gitignored) and fill in values.
# Shell environment variables override these.

# --- Model under test (read by app.core.config) ---------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=300

# --- Optional llama.cpp provider -------------------------------------------
# The model ID must match llama-server's /v1/models response.
# Keep these commented to leave the default provider as Ollama.
# LLM_PROVIDER=llama_cpp
# LLM_MODEL=your-model-id
# LLAMA_CPP_BASE_URL=http://localhost:8080/v1
# LLAMA_CPP_MODELS=your-model-id
# LLAMA_CPP_API_KEY=
# LLM_TIMEOUT=300
# LLM_ALLOW_EXTERNAL=false

# --- LLM judge ------------------------------------------------------------
# JUDGE_HOST defaults to OLLAMA_HOST.
# JUDGE_HOST=http://localhost:11434
JUDGE_MODEL=qwen3.5:4b
JUDGE_TIMEOUT_SECONDS=300
